# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# development mode 后台请求地址（本机后端默认 8088 端口；如后端地址不同，
# 在本机 env/.env.local 里覆盖即可，不要改这里提交）
VITE_SERVER_BASEURL = 'http://localhost:8088'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = ''

# 本地开发默认关闭 Mock 拦截，连接后台服务（如需使用 Mock 请运行 pnpm dev:mock）
VITE_ENABLE_MOCK = false
VITE_MOCK_DELAY = 100

# 本地联调 tz-oauth（默认直连生产授权服务；如需连本地 tz-oauth 实例可切换为 http://localhost:8088）
# 选项 A（连本地）：VITE_OAUTH_BASE_URL = 'http://localhost:8088'
# 选项 B（连生产，默认开启）：
VITE_OAUTH_BASE_URL = 'https://oauth.tiaozhan.com'

# 本地开发小程序专用 H5 站点源
VITE_MP_AUTH_ORIGIN = 'http://127.0.0.1:9000'
