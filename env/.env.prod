# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode 后台请求地址（只需要域名，系统会自动在代码中拼接 /api 前缀）
VITE_SERVER_BASEURL = 'https://tuxun.tiaozhan.com'
# 微信小程序体验版与正式版 HTTPS API 域名
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://tuxun.tiaozhan.com'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://tuxun.tiaozhan.com'

# tz-oauth 生产授权服务地址
VITE_OAUTH_BASE_URL = 'https://oauth.tiaozhan.com'

# 小程序专用：H5 站点源（静态中转页 /static/mp-auth-relay.html 需在 tz-oauth 管理端与后端白名单注册）
VITE_MP_AUTH_ORIGIN = 'https://tuxun.tiaozhan.com'

# 高德地图生产环境 Key 配置（绑定生产域名/小程序白名单）
VITE_AMAP_KEY = 'b42518a6c7e9f0600567f26b6fba48ff'
VITE_AMAP_SECURITY_JSCODE = ''
VITE_AMAP_SERVICE_HOST = '/_AMapService'
