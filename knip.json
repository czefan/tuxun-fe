{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "paths": {
    "@/*": ["./src/*"],
    "@img/*": ["./src/static/images/*"]
  },
  "entry": [
    "src/App.ku.vue",
    "src/pages/**/*.vue",
    "src/subPages/**/*.vue",
    "src/app/**/*.vue",
    "src/mocks/browser.ts",
    "src/mocks/node.ts",
    "pages.config.ts",
    "manifest.config.ts",
    "build/**/*.ts",
    "scripts/*.js"
  ],
  "project": ["src/**/*.{ts,vue,css}", "build/**/*.ts"],
  "ignore": ["src/env.d.ts"],
  "ignoreDependencies": ["@dcloudio/.*", "postcss", "@tanstack/query-core"],
  "vite": false,
  "ignoreBinaries": ["uv", "git-cliff"]
}
