# 图寻前端 (tuxun-fe) Nginx 部署参考配置
# SPA 模式（History 路由模式必须配置 try_files 回退 index.html，否则页面刷新或 CAS 回调地址会报 404）

server {
    listen 80;
    server_name your-domain.com;

    # 注意：root 应指向 uni-app 的实际产物目录 dist/build/h5，
    # 不是很多人默认以为的 dist/（dist 下没有可直接部署的 index.html）
    root /var/www/tuxun-fe/dist/build/h5;
    index index.html;

    # uni-app H5 产物 JS 占比高，压缩收益明显（以下为示例，可按需按 mime 细化）
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # H5 History 路由 fallback 关键配置
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html 绝不能缓存：/assets/ 是内容 hash + 强缓存，
    # 一旦 index.html 被缓存，用户会一直加载旧版本的 assets 引用
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # 静态资源强缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API 反向代理配置（若前后端同域名部署）
    # location /api/ {
    #     proxy_pass http://127.0.0.1:8088/api/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
}
