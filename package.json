{
  "name": "tuxun-fe",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "unibest": {
    "platforms": [
      "h5",
      "mp-weixin"
    ],
    "uiLibrary": "wot-ui-v2",
    "loginStrategy": true,
    "i18n": true,
    "chartLibraries": [],
    "cliVersion": "4.0.16",
    "unibestVersion": "4.4.1",
    "unibestUpdateTime": "2026-05-22",
    "createdAt": "2026-06-28 14:20:32"
  },
  "packageManager": "pnpm@11.9.0",
  "description": "图寻 UniApp 前端项目",
  "author": "czefan",
  "license": "MIT",
  "homepage": "",
  "repository": {},
  "bugs": {},
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "pnpm init-baseFiles",
    "preinstall": "npx only-allow pnpm",
    "init-baseFiles": "node ./scripts/create-base-files.js",
    "gen:api-types": "openapi-typescript contract/apifox-import.json -o src/service/contract/schema.d.ts",
    "dev": "uni --mode dev",
    "dev:mock": "uni --mode mock",
    "dev:test": "uni --mode test",
    "dev:mp": "uni -p mp-weixin --mode dev",
    "dev:mp:test": "uni -p mp-weixin --mode test",
    "build": "pnpm build:h5",
    "build:h5": "uni build --mode prod",
    "postbuild:h5": "node ./scripts/check-build-output.js --dir=dist/build/h5",
    "build:h5:test": "uni build --mode test",
    "postbuild:h5:test": "node ./scripts/check-build-output.js --dir=dist/build/h5",
    "build:mp": "uni build -p mp-weixin --mode prod",
    "postbuild:mp": "node ./scripts/check-build-output.js --platform=mp --dir=dist/build/mp-weixin",
    "build:mp:test": "uni build -p mp-weixin --mode test",
    "postbuild:mp:test": "node ./scripts/check-build-output.js --platform=mp --dir=dist/build/mp-weixin",
    "upload:mp": "node ./scripts/upload-weixin.js",
    "analyze:h5": "cross-env VITE_BUNDLE_ANALYZE=true VITE_BUNDLE_ANALYZE_OPEN=true pnpm build:h5",
    "analyze:mp": "cross-env VITE_BUNDLE_ANALYZE=true SKIP_OPEN_DEVTOOLS=true pnpm build:mp && pnpm analyze:mp:size",
    "analyze:mp:size": "node ./scripts/analyze-weixin-package.js",
    "check": "pnpm check:assets && pnpm lint:quick && pnpm lint:eslint:ci && pnpm knip && pnpm type-check && pnpm test:run",
    "check:parallel": "node ./scripts/run-checks.js check:assets lint:quick lint:eslint:ci knip type-check test:run",
    "check:assets": "node ./scripts/check-static-assets.js",
    "check:contract": "uv run python ./scripts/check-contract.py",
    "check:boundaries": "uv run python ./scripts/check-boundaries.py",
    "type-check": "vue-tsc --noEmit",
    "knip": "knip",
    "lint": "node ./scripts/run-checks.js lint:quick lint:eslint",
    "lint:quick": "oxlint",
    "lint:eslint": "eslint --cache --cache-location .eslintcache --max-warnings=0",
    "lint:eslint:ci": "eslint --max-warnings=0",
    "lint:fix": "oxlint --fix && eslint --fix",
    "fmt": "oxfmt --write \"**/*.{css,scss,html,json,jsonc,md}\" --no-error-on-unmatched-pattern",
    "fmt:check": "oxfmt --check \"**/*.{css,scss,html,json,jsonc,md}\" --no-error-on-unmatched-pattern",
    "test": "vitest",
    "test:run": "vitest run",
    "bump-version": "node ./scripts/bump-version.js",
    "changelog": "changelogen --output CHANGELOG.md --no-commit --no-tag"
  },
  "dependencies": {
    "@dcloudio/uni-app": "catalog:",
    "@dcloudio/uni-components": "catalog:",
    "@dcloudio/uni-h5": "catalog:",
    "@dcloudio/uni-mp-weixin": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@wot-ui/ui": "catalog:",
    "dayjs": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "qrcode-generator": "catalog:",
    "ufo": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@dcloudio/types": "catalog:",
    "@dcloudio/uni-automator": "catalog:",
    "@dcloudio/uni-cli-shared": "catalog:",
    "@dcloudio/uni-stacktracey": "catalog:",
    "@dcloudio/vite-plugin-uni": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@iconify/utils": "catalog:",
    "@types/node": "catalog:",
    "@uni-helper/eslint-config": "catalog:",
    "@uni-helper/plugin-uni": "catalog:",
    "@uni-helper/uni-env": "catalog:",
    "@uni-helper/uni-types": "catalog:",
    "@uni-helper/unocss-preset-uni": "catalog:",
    "@uni-helper/vite-plugin-uni-components": "catalog:",
    "@uni-helper/vite-plugin-uni-manifest": "catalog:",
    "@uni-helper/vite-plugin-uni-pages": "catalog:",
    "@uni-helper/vite-plugin-uni-platform": "catalog:",
    "@uni-ku/bundle-optimizer": "catalog:",
    "@uni-ku/root": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-legacy-compat": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "changelogen": "catalog:",
    "cross-env": "catalog:",
    "enquirer": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-format": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "miniprogram-api-typings": "catalog:",
    "miniprogram-ci": "catalog:",
    "msw": "catalog:",
    "openapi-typescript": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "picocolors": "catalog:",
    "postcss": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "sass": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-auto-import": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --allow-empty",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,vue}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "*.{scss,css,html,json,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
