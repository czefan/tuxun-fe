{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "ignorePatterns": [
    "dist",
    "node_modules",
    "**/uni_modules/**",
    "**/nativeplugins/**",
    "auto-import.d.ts",
    "uni-pages.d.ts",
    "src/pages.json",
    "src/manifest.json",
    "src/service/contract/schema.d.ts",
    "src/typings.d.ts"
  ],
  "rules": {
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-unreachable": "off",
    "eslint/no-unused-expressions": "off",
    "eslint/no-unused-vars": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-module-specifiers": "off"
  },
  "overrides": [
    {
      "files": ["src/pages/**", "src/subPages/**", "src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/service/contract/schema", "@/service/contract/schema"],
                "message": "严禁在 pages / subPages / app 中直接 import raw schema.d.ts！请通过业务域 View Model 引入。"
              },
              {
                "group": ["@/service/contract/*", "**/service/contract/*"],
                "message": "编排层（pages / subPages / app）严禁跨过 features 直接依赖底层 contract 原始定义。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/pages/**", "@/subPages/**", "@/app/**"],
                "message": "业务域模块严禁反向依赖编排层（pages / subPages / app）。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**",
        "src/composables/**",
        "src/utils/**",
        "src/constants/**",
        "src/styles/**",
        "src/router/**",
        "src/store/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "基础公共层（components / composables / utils / constants / styles / router / store）严禁反向依赖业务域 features。应用外壳请放 src/app。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/activity/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**", "!@/features/activity/**"],
                "message": "业务域之间禁止互相依赖，请把公共部分下沉到 service 或 shared。"
              }
            ]
          }
        ]
      }
    },
    {
